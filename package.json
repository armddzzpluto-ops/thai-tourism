{
  "name": "thailand-travel-guide-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "build:destinations": "node scripts/build/generate-destination-pages.mjs",
    "curate:showcase": "node scripts/curation/curate-showcase-galleries.mjs && node scripts/curation/sync-image-curation.mjs",
    "check": "node scripts/quality/check-site.mjs",
    "verify": "npm run check && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "memory:update": "node scripts/maintenance/update-ai-memory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0"
  }
}
